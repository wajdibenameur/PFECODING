{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Spring Boot backend",
			"type": "shell",
			"command": "./mvnw clean verify",
			"problemMatcher": [
				"$javac"
			],
			"group": "build"
		},
		{
			"label": "Build Angular frontend",
			"type": "shell",
			"command": "npm run build --prefix frontend",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}