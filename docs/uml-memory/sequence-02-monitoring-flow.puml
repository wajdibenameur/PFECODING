@startuml
title Unified Monitoring Collection Flow

actor "Monitoring Operator" as User
boundary "MonitoringDashboardPageComponent" as Page
control "MonitoringStore" as Store
control "MonitoringApiService" as Api
control "MonitoringController" as Controller
control "ZabbixIntegrationService" as Zabbix
control "ObserviumIntegrationService" as Observium
control "ZkBioIntegrationService" as ZKBio
control "CameraIntegrationService" as Camera
database "SnapshotStore" as Snapshots
control "SourceAvailabilityService" as Availability
control "MonitoringWebSocketPublisher" as MonitoringWs
control "ZkBioWebSocketPublisher" as ZkBioWs

User -> Page : click "Collect All"
Page -> Store : triggerCollection("all")
Store -> Api : POST /api/monitoring/collect
Api -> Controller : collectAll()

Controller -> Zabbix : refresh()
alt Zabbix live fetch succeeds
  Zabbix -> Snapshots : save(hosts/problems/metrics,\nfreshness=live)
  Zabbix -> Availability : markAvailable("ZABBIX")
else Zabbix live fetch fails and snapshot exists
  Zabbix -> Snapshots : get(dataset,"ZABBIX")
  Zabbix -> Snapshots : save(degraded snapshot,\nfreshness=snapshot_fallback)
  Zabbix -> Availability : markDegraded("ZABBIX", error)
else Zabbix live fetch fails and no snapshot exists
  Zabbix -> Availability : markUnavailable("ZABBIX", error)
end

Controller -> Observium : refresh()
Observium -> Snapshots : save(hosts/problems/metrics)
Observium -> Availability : markAvailable() or markDegraded()/markUnavailable()

Controller -> ZKBio : refresh()
ZKBio -> Snapshots : save(hosts/problems/metrics)
ZKBio -> Availability : markAvailable() or markDegraded()/markUnavailable()

Controller -> ZKBio : refreshAttendance()
ZKBio -> Snapshots : save(status/devices/attendance)

Controller -> Camera : refresh()
Camera -> Snapshots : save(hosts)

Controller -> MonitoringWs : publishProblemsFromSnapshot(ZABBIX)
Controller -> MonitoringWs : publishMetricsFromSnapshot(ZABBIX)
Controller -> MonitoringWs : publishProblemsFromSnapshot(OBSERVIUM)
Controller -> MonitoringWs : publishMetricsFromSnapshot(OBSERVIUM)
Controller -> MonitoringWs : publishProblemsFromSnapshot(ZKBIO)
Controller -> MonitoringWs : publishMetricsFromSnapshot(ZKBIO)
Controller -> ZkBioWs : publishAttendanceFromSnapshot()
Controller -> ZkBioWs : publishDevicesFromSnapshot()
Controller -> ZkBioWs : publishStatusFromSnapshot()

Controller --> Api : ApiResponse(success=true)
Api --> Store : success response
Store -> Store : scheduleSnapshotRefresh()

opt delayed snapshot reload
  Store -> Api : GET /api/monitoring/hosts
  Store -> Api : GET /api/monitoring/problems
  Store -> Api : GET /api/monitoring/metrics
end

@enduml
