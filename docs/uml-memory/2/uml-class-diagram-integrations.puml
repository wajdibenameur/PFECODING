@startuml
skinparam classAttributeIconSize 0
hide empty members

interface AsyncIntegrationService
interface ZkBioIntegrationOperations

class ZabbixIntegrationService
class ObserviumIntegrationService
class ZkBioIntegrationService
class CameraIntegrationService

class ZabbixAdapter
class ObserviumAdapter
class ZkBioAdapter
class CameraAdapter

class ZabbixClient
class ObserviumClientX
class ZkBioClientX

class ZabbixMetricsServiceImpl
class ZabbixProblemServiceImpl
class SourceAvailabilityServiceImpl
class SnapshotStore
class MonitoringSnapshotPublicationService
class ZkBioRefreshOrchestrationService

AsyncIntegrationService <|.. ZabbixIntegrationService
AsyncIntegrationService <|.. ObserviumIntegrationService
AsyncIntegrationService <|.. ZkBioIntegrationService
AsyncIntegrationService <|.. CameraIntegrationService
ZkBioIntegrationOperations <|.. ZkBioIntegrationService

ZabbixIntegrationService --> ZabbixAdapter
ZabbixIntegrationService --> ZabbixMetricsServiceImpl
ZabbixIntegrationService --> ZabbixProblemServiceImpl
ZabbixIntegrationService --> SnapshotStore
ZabbixIntegrationService --> SourceAvailabilityServiceImpl

ObserviumIntegrationService --> ObserviumAdapter
ObserviumIntegrationService --> SnapshotStore
ObserviumIntegrationService --> SourceAvailabilityServiceImpl

ZkBioIntegrationService --> ZkBioAdapter
ZkBioIntegrationService --> SnapshotStore
ZkBioIntegrationService --> SourceAvailabilityServiceImpl
ZkBioIntegrationService --> MonitoringSnapshotPublicationService

CameraIntegrationService --> CameraAdapter
CameraIntegrationService --> SnapshotStore
CameraIntegrationService --> SourceAvailabilityServiceImpl

ZabbixAdapter --> ZabbixClient
ObserviumAdapter --> ObserviumClientX
ZkBioAdapter --> ZkBioClientX

ZkBioRefreshOrchestrationService --> ZkBioIntegrationOperations

note bottom of ZabbixClient
Light and heavy resilience profiles
are separated.
end note

note bottom of CameraAdapter
Socket-based integration without
dedicated HTTP client.
end note
@enduml
