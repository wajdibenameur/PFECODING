@startuml
actor "Viewer Support" as Viewer
participant MonitoringController
participant MonitoringAggregationService
participant MonitoringCacheService
participant SnapshotStore
participant TicketController
participant TicketServiceImpl

Viewer -> MonitoringController : GET /api/monitoring/problems
MonitoringController -> MonitoringAggregationService : getProblems(null)
MonitoringAggregationService -> MonitoringCacheService : load problems snapshot
MonitoringCacheService -> SnapshotStore : get("problems", source)
SnapshotStore --> MonitoringCacheService : stored snapshot(s)
MonitoringCacheService --> MonitoringAggregationService : normalized data
MonitoringAggregationService --> MonitoringController : UnifiedMonitoringResponse
MonitoringController --> Viewer : unified problems

Viewer -> TicketController : POST /api/tickets/from-problem
TicketController -> TicketServiceImpl : createFromProblem(problem, creatorId)
TicketServiceImpl --> TicketController : Ticket
TicketController --> Viewer : TicketResponseDTO
@enduml
