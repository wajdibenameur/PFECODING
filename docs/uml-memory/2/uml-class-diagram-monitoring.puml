@startuml
skinparam classAttributeIconSize 0
hide empty members

class MonitoringController {
  +getProblems()
  +getMetrics()
  +getHosts()
  +getSourceHealth()
  +collectAll()
}

class MonitoringStartup {
  +warmupInitialSnapshots()
}

class MonitoringAggregationService {
  +getProblems(source)
  +getMetrics(source)
  +getHosts(source)
}

class MonitoringCacheService

interface SnapshotStore {
  +save(dataset, source, snapshot)
  +get(dataset, source)
}

class InMemorySnapshotStore
class StoredSnapshot

interface AsyncIntegrationService {
  +getSourceType()
  +refreshAsync()
}

class IntegrationServiceRegistry {
  +getRequired(sourceType)
}

class ZkBioRefreshOrchestrationService {
  +refreshMonitoringAndAttendanceAsync()
}

class MonitoringSnapshotPublicationService {
  +publishMonitoringSnapshots(source)
  +publishProblemsSnapshot(source)
  +publishMetricsSnapshot(source)
  +publishZkBioSnapshots()
}

class SourceAvailabilityServiceImpl {
  +markAvailable(source)
  +markDegraded(source, message)
  +markUnavailable(source, message)
  +shouldAttempt(source, backoffMs)
}

class ZabbixIntegrationService {
  +refreshAsync()
  +refreshHosts()
  +refreshProblems()
  +refreshMetricsAsync()
}

class ObserviumIntegrationService {
  +refreshAsync()
}

class ZkBioIntegrationService {
  +refreshAsync()
  +refreshAttendanceAsync()
  +refreshAllAndPublishAsync()
}

class CameraIntegrationService {
  +refreshAsync()
}

class MonitoringWebSocketPublisher
class ZkBioWebSocketPublisher

MonitoringController --> MonitoringAggregationService
MonitoringController --> SourceAvailabilityServiceImpl
MonitoringController --> IntegrationServiceRegistry
MonitoringController --> ZkBioRefreshOrchestrationService
MonitoringController --> MonitoringSnapshotPublicationService

MonitoringStartup --> IntegrationServiceRegistry
MonitoringStartup --> ZkBioRefreshOrchestrationService
MonitoringStartup --> MonitoringSnapshotPublicationService

MonitoringAggregationService --> MonitoringCacheService
MonitoringCacheService --> SnapshotStore
SnapshotStore <|.. InMemorySnapshotStore
SnapshotStore --> StoredSnapshot

IntegrationServiceRegistry --> AsyncIntegrationService
AsyncIntegrationService <|.. ZabbixIntegrationService
AsyncIntegrationService <|.. ObserviumIntegrationService
AsyncIntegrationService <|.. ZkBioIntegrationService
AsyncIntegrationService <|.. CameraIntegrationService

ZkBioRefreshOrchestrationService --> ZkBioIntegrationService

ZabbixIntegrationService --> SnapshotStore
ObserviumIntegrationService --> SnapshotStore
ZkBioIntegrationService --> SnapshotStore
CameraIntegrationService --> SnapshotStore

ZabbixIntegrationService --> SourceAvailabilityServiceImpl
ObserviumIntegrationService --> SourceAvailabilityServiceImpl
ZkBioIntegrationService --> SourceAvailabilityServiceImpl
CameraIntegrationService --> SourceAvailabilityServiceImpl

MonitoringSnapshotPublicationService --> MonitoringWebSocketPublisher
MonitoringSnapshotPublicationService --> ZkBioWebSocketPublisher
SourceAvailabilityServiceImpl --> MonitoringWebSocketPublisher

note bottom of ZabbixIntegrationService
Implements the fallback ladder:
live -> in-memory snapshot -> persisted fallback -> empty snapshot
end note
@enduml
