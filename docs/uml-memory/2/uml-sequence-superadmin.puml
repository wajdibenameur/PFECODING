@startuml
actor SuperAdmin
participant TicketController
participant TicketServiceImpl
participant UserRepository
participant TicketRepository
participant InterventionRepository
participant "WebSocket /topic/tickets" as TicketTopic

SuperAdmin -> TicketController : POST /api/tickets/{id}/validate
TicketController -> TicketServiceImpl : validate(ticketId, adminId)
TicketServiceImpl -> UserRepository : findById(adminId)
TicketServiceImpl -> TicketRepository : findById(ticketId)
TicketServiceImpl -> InterventionRepository : save(validation intervention)
TicketServiceImpl -> TicketRepository : save(ticket VALIDATED)
TicketServiceImpl -> TicketTopic : notify("VALIDATED", ticket)
TicketServiceImpl --> TicketController : Ticket
TicketController --> SuperAdmin : TicketResponseDTO

note right of SuperAdmin
Role name is modelled in code.
Backend authorization is inferred,
not enforced.
end note
@enduml
