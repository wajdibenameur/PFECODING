@startuml
title ZKBio Manual Refresh And Publication

actor "Monitoring Operator" as User
boundary "MonitoringZkBioPageComponent" as Page
control "MonitoringApiService" as Api
control "ZkBioController" as Controller
control "ZkBioIntegrationService" as Integration
control "ZkBioAdapter" as Adapter
control "ZkBioServiceImpl" as ZkBioService
control "ZkBioClientX" as Client
database "SnapshotStore" as Snapshots
control "MonitoringWebSocketPublisher" as MonitoringWs
control "ZkBioWebSocketPublisher" as ZkBioWs
control "MonitoringRealtimeService" as Realtime
control "StompClientService" as Stomp

User -> Page : click "Collect ZKBio"
Page -> Api : POST /api/zkbio/collect
Api -> Controller : triggerCollection()
Controller -> Integration : refreshAllAndPublish()

par refresh monitoring snapshots
  Integration -> Adapter : fetchAll()
  Adapter -> Client : getDevices()
  Client --> Adapter : devices JSON
  Adapter --> Integration : List<ServiceStatusDTO>
  Integration -> Snapshots : save("hosts","ZKBIO", ...)

  Integration -> Adapter : fetchProblems()
  Adapter -> Client : getAlerts()
  Client --> Adapter : alerts JSON
  Adapter --> Integration : List<ZkBioProblemDTO>
  Integration -> Snapshots : save("problems","ZKBIO", ...)

  Integration -> Adapter : fetchMetrics()
  Adapter -> Client : getDevices()
  Client --> Adapter : devices JSON
  Adapter --> Integration : List<ZkBioMetricDTO>
  Integration -> Snapshots : save("metrics","ZKBIO", ...)
and refresh business snapshots
  Integration -> ZkBioService : getServerStatus()
  ZkBioService -> Client : getStatus()
  Client --> ZkBioService : status JSON
  ZkBioService --> Integration : ServiceStatusDTO
  Integration -> Snapshots : save("status","ZKBIO", ...)

  Integration -> ZkBioService : fetchDevices()
  ZkBioService -> Adapter : fetchAll()
  Adapter -> Client : getDevices()
  Client --> Adapter : devices JSON
  Adapter --> ZkBioService : List<ServiceStatusDTO>
  ZkBioService --> Integration : List<ServiceStatusDTO>
  Integration -> Snapshots : save("devices","ZKBIO", ...)

  Integration -> ZkBioService : fetchAttendanceLogs()
  ZkBioService -> Client : getAttendanceLogs()
  Client --> ZkBioService : attendance JSON
  ZkBioService --> Integration : List<ZkBioAttendanceDTO>
  Integration -> Snapshots : save("attendance","ZKBIO", ...)
end

Integration -> MonitoringWs : publishProblemsFromSnapshot(ZKBIO)
Integration -> MonitoringWs : publishMetricsFromSnapshot(ZKBIO)
Integration -> ZkBioWs : publishAttendanceFromSnapshot()
Integration -> ZkBioWs : publishDevicesFromSnapshot()
Integration -> ZkBioWs : publishStatusFromSnapshot()

Controller --> Api : ApiResponse(success=true)

opt page is already subscribed
  Page -> Realtime : monitoringProblems$()
  Realtime -> Stomp : subscribe("/topic/monitoring/problems")
  Page -> Realtime : monitoringMetrics$()
  Realtime -> Stomp : subscribe("/topic/monitoring/metrics")
  Page -> Realtime : zkbioAttendance$()
  Realtime -> Stomp : subscribe("/topic/zkbio/attendance")
  Page -> Realtime : zkbioDevices$()
  Realtime -> Stomp : subscribe("/topic/zkbio/devices")
  Page -> Realtime : zkbioStatus$()
  Realtime -> Stomp : subscribe("/topic/zkbio/status")
  Stomp --> Page : monitoring + ZKBio updates
end

@enduml
