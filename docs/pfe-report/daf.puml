@startuml
title PFE Monitoring System - Class Diagram
hide empty members
skinparam classAttributeIconSize 0

package "Controllers" {
  class MonitoringController <<RestController>>
  class ZkBioController <<RestController>>
  class DashboardController <<RestController>>
  class TicketController <<RestController>>
}

package "Monitoring Core" {
  interface IntegrationService
  class MonitoringAggregationService
  class MonitoringCacheService
  interface SnapshotStore
  class InMemorySnapshotStore
  class StoredSnapshot~T~
  interface SourceAvailabilityService
  class SourceAvailabilityServiceImpl
  class MonitoringWebSocketPublisher
  class ZkBioWebSocketPublisher
  enum MonitoringSourceType
}

package "Integration Layer" {
  class ZabbixIntegrationService
  class ObserviumIntegrationService
  class ZkBioIntegrationService
  class CameraIntegrationService
  class ZabbixAdapter
  class ObserviumAdapter
  class ZkBioAdapter
  class ZabbixClient
  class ObserviumClientX
  class ZkBioClientX
}

package "Business And Analytics" {
  interface DashboardService
  class DashboardServiceImpl
  interface TicketService
  class TicketServiceImpl
  interface ZkBioServiceInterface
  class ZkBioServiceImpl
  class TorchScriptPredictionService
}

package "Persistence" {
  class BaseEntity <<MappedSuperclass>>
  class MonitoredHost <<Entity>>
  class ZabbixProblem <<Entity>>
  class ZabbixMetric <<Entity>>
  class Ticket <<Entity>>
  class User <<Entity>>
  class MonitoredHostRepository <<JpaRepository>>
  class ZabbixProblemRepository <<JpaRepository>>
  class ZabbixMetricRepository <<JpaRepository>>
  class TicketRepository <<JpaRepository>>
  class UserRepository <<JpaRepository>>
}

package "DTOs" {
  class UnifiedMonitoringResponse~T~ <<DTO>>
  class UnifiedMonitoringHostDTO <<DTO>>
  class UnifiedMonitoringProblemDTO <<DTO>>
  class UnifiedMonitoringMetricDTO <<DTO>>
}

MonitoringController --> MonitoringAggregationService
MonitoringController --> SourceAvailabilityService
MonitoringController --> ZabbixIntegrationService
MonitoringController --> ObserviumIntegrationService
MonitoringController --> ZkBioIntegrationService
MonitoringController --> CameraIntegrationService
MonitoringController --> MonitoringWebSocketPublisher
MonitoringController --> ZkBioWebSocketPublisher
MonitoringController ..> UnifiedMonitoringResponseT

ZkBioController --> ZkBioServiceInterface
ZkBioController --> IntegrationService : zkBioIntegrationService
DashboardController --> DashboardService
TicketController --> TicketService

MonitoringAggregationService --> MonitoringCacheService
MonitoringAggregationService --> MonitoringSourceType
MonitoringCacheService --> SnapshotStore
SnapshotStore <|.. InMemorySnapshotStore
SnapshotStore ..> StoredSnapshotT

SourceAvailabilityService <|.. SourceAvailabilityServiceImpl
SourceAvailabilityServiceImpl --> MonitoringWebSocketPublisher

IntegrationService <|.. ZabbixIntegrationService
IntegrationService <|.. ObserviumIntegrationService
IntegrationService <|.. ZkBioIntegrationService
IntegrationService <|.. CameraIntegrationService

ZabbixIntegrationService --> ZabbixAdapter
ZabbixIntegrationService --> SnapshotStore
ZabbixIntegrationService --> SourceAvailabilityService

ObserviumIntegrationService --> ObserviumAdapter
ObserviumIntegrationService --> SnapshotStore
ObserviumIntegrationService --> SourceAvailabilityService

ZkBioIntegrationService --> ZkBioAdapter
ZkBioIntegrationService --> ZkBioServiceInterface
ZkBioIntegrationService --> SnapshotStore
ZkBioIntegrationService --> SourceAvailabilityService
ZkBioIntegrationService --> MonitoringWebSocketPublisher
ZkBioIntegrationService --> ZkBioWebSocketPublisher

CameraIntegrationService --> SnapshotStore

ZabbixAdapter --> ZabbixClient
ObserviumAdapter --> ObserviumClientX
ZkBioAdapter --> ZkBioClientX
ZkBioServiceImpl --> ZkBioAdapter
ZkBioServiceImpl --> ZkBioClientX

DashboardService <|.. DashboardServiceImpl
DashboardServiceImpl --> ZabbixProblemRepository
DashboardServiceImpl --> ZabbixMetricRepository
DashboardServiceImpl --> MonitoredHostRepository
DashboardServiceImpl --> TorchScriptPredictionService

TicketService <|.. TicketServiceImpl
TicketServiceImpl --> TicketRepository
TicketServiceImpl --> UserRepository

BaseEntity <|-- MonitoredHost
BaseEntity <|-- ZabbixProblem
BaseEntity <|-- ZabbixMetric
BaseEntity <|-- Ticket
BaseEntity <|-- User

MonitoredHostRepository --> MonitoredHost
ZabbixProblemRepository --> ZabbixProblem
ZabbixMetricRepository --> ZabbixMetric
TicketRepository --> Ticket
UserRepository --> User

Ticket "0..*" --> "1" User : createdBy
Ticket "0..*" --> "0..1" User : assignedTo
Ticket "0..*" --> "0..1" User : validatedBy

MonitoringAggregationService ..> UnifiedMonitoringHostDTO
MonitoringAggregationService ..> UnifiedMonitoringProblemDTO
MonitoringAggregationService ..> UnifiedMonitoringMetricDTO

@enduml
